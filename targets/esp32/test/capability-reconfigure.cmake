# The generated configuration remains authoritative across IDF configure passes.
set(GEA_BUILD_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/capability-config-fixture.cmake")
set(GEA_TEST_AUDIO 1)
set(GEA_TEST_CAMERA 0)
set(GEA_TEST_AEC 1)
set(ENV{GEA_EMBEDDED_CAPABILITY_CAMERA} "1")
include("${CMAKE_CURRENT_LIST_DIR}/../app_project.cmake")
if(NOT GEA_EMBEDDED_CAPABILITY_AUDIO OR GEA_EMBEDDED_CAPABILITY_CAMERA OR NOT GEA_EMBEDDED_CAPABILITY_AEC)
  message(FATAL_ERROR "Generated capabilities lost or overridden by shell environment")
endif()
set(GEA_TEST_AUDIO 0)
set(GEA_TEST_CAMERA 1)
set(GEA_TEST_AEC 0)
include("${CMAKE_CURRENT_LIST_DIR}/../app_project.cmake")
if(GEA_EMBEDDED_CAPABILITY_AUDIO OR NOT GEA_EMBEDDED_CAPABILITY_CAMERA OR GEA_EMBEDDED_CAPABILITY_AEC)
  message(FATAL_ERROR "Reconfigure retained stale capability decisions")
endif()
message(STATUS "Capability reconfiguration follows generated app analysis")
